rules_version = '2';

// FlowU — กฎขั้นต่ำของสัปดาห์ที่ 7: ต้องล็อกอินก่อน ถึงจะอ่าน/เขียนได้
// ยังไม่แยกสิทธิ์ตาม role (student/approver/staff) — เริ่มแยกจริงสัปดาห์ที่ 8 (ดู ACL.md)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
